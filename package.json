{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server.ts",
    "start": "tsx server.ts",
    "build": "vite build",
    "build:owner": "vite build --mode owner",
    "android:sync": "npm run build:owner && cap sync android",
    "android": "npm run android:sync && cd android && gradlew.bat assembleDebug",
    "test": "tsx --test tests/native-owner-auth.test.ts",
    "preview": "tsx server.ts --preview --port 4173",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@zip.js/zip.js": "^2.24.0",
    "canvas-confetti": "^1.9.4",
    "country-state-city": "^3.2.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
